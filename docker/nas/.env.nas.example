# Copy to .env.nas on the NAS and fill real values there.
# Keep this file shell-compatible because deploy-nas-blue-green.sh sources it.

BASE_URL=http://dunblack.synology.me:8080
SPRING_PROFILES_ACTIVE=nas

SHORTBRIDGE_HTTP_PORT=8080
TRAEFIK_API_PORT=8081
RABBITMQ_MANAGEMENT_PORT=15672
SHORTBRIDGE_NETWORK=shortbridge-nas-net

# If MariaDB is installed directly on Synology, use the NAS LAN IP.
# The current LAN scan found Synology at 192.168.31.2.
NAS_DB_HOST=192.168.31.2
NAS_DB_PORT=3306
NAS_DB_USER=shortbridge
NAS_DB_PASSWORD=change-me

RABBITMQ_DEFAULT_USER=shortbridge
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_URL=amqp://shortbridge:change-me@shortbridge-rabbitmq:5672/%2f

# 64 hex chars, for example: openssl rand -hex 32
TOKEN_KEY_V1=replace-with-64-hex-chars

GOOGLE_CLIENT_ID=not-set
GOOGLE_CLIENT_SECRET=not-set
YOUTUBE_CLIENT_ID=not-set
YOUTUBE_CLIENT_SECRET=not-set
TIKTOK_CLIENT_KEY=not-set
TIKTOK_CLIENT_SECRET=not-set
INSTAGRAM_CLIENT_ID=not-set
INSTAGRAM_CLIENT_SECRET=not-set

YOUTUBE_ENABLED=false
INSTAGRAM_ENABLED=false
TIKTOK_ENABLED=false

# Optional runtime tuning. The deploy script applies this after --env-file.
JAVA_OPTS="-Xms128m -Xmx512m -XX:+UseG1GC"
