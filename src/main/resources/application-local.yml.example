spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/shortbridge
    username: shortbridge
    password: shortbridge
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
  rabbitmq:
    host: localhost
    port: 5672
    username: shortbridge
    password: shortbridge
  security:
    oauth2:
      client:
        registration:
          google:
            client-id: REPLACE_ME
            client-secret: REPLACE_ME
            scope:
              - openid
              - email
              - profile
          instagram:
            client-id: REPLACE_ME
            client-secret: REPLACE_ME
            client-authentication-method: client_secret_post
            authorization-grant-type: authorization_code
            redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
            scope:
              - instagram_business_basic
              - instagram_business_content_publish
            client-name: Instagram
          youtube:
            client-id: REPLACE_ME
            client-secret: REPLACE_ME
            scope:
              - https://www.googleapis.com/auth/youtube.upload
            redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
            client-name: YouTube
            provider: google
          tiktok:
            client-id: REPLACE_ME
            client-secret: REPLACE_ME
            client-authentication-method: client_secret_post
            authorization-grant-type: authorization_code
            redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
            scope:
              - user.info.basic
              - video.publish
            client-name: TikTok
        provider:
          instagram:
            authorization-uri: https://api.instagram.com/oauth/authorize
            token-uri: https://api.instagram.com/oauth/access_token
            user-info-uri: https://graph.instagram.com/me?fields=id,username,account_type
            user-name-attribute: id
          tiktok:
            authorization-uri: https://www.tiktok.com/v2/auth/authorize/
            token-uri: https://open.tiktokapis.com/v2/oauth/token/
            user-info-uri: https://open.tiktokapis.com/v2/user/info/
            user-name-attribute: open_id

shortbridge:
  storage:
    type: local
